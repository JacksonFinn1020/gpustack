{
  "custom-http-standard": {
    "runtime": "custom-http",
    "branch": "origin/custom-http-standard",
    "dockerfile": "Dockerfile",
    "container_port": 9670,
    "container_model_path": "/data/model",
    "health_path": "/health",
    "health_expect_json": {
      "status": "ok",
      "engine_ready": true
    },
    "health_require_nonempty_data": false,
    "environment": {
      "MODEL_PATH": "/data/model",
      "MODEL_NAME": "custom-http-standard",
      "SERVICE_HOST": "0.0.0.0",
      "SERVICE_PORT": "9670",
      "MODEL_DEVICE": "cuda:0",
      "HF_HUB_OFFLINE": "1",
      "TRANSFORMERS_OFFLINE": "1"
    },
    "required_files": [],
    "security_profile": "restricted"
  }
}
